# サーバー
PORT=3000
# LINE のボタン・リンクに使う公開 URL
PUBLIC_BASE_URL=http://localhost:3000
# 設定すると管理画面に Basic 認証がかかる（ユーザー名は任意）
ADMIN_PASSWORD=

# ① 予約検知
# Webhook の共有シークレット（X-Webhook-Secret ヘッダー）
AIRHOST_WEBHOOK_SECRET=
EMAIL_WEBHOOK_SECRET=

# ③ AirHost 清掃カレンダー登録  mock | api | rpa
AIRHOST_MODE=mock
AIRHOST_API_BASE=
AIRHOST_API_KEY=
AIRHOST_WORKER_SECRET=

# ④ LINE Messaging API（未設定ならモック送信）
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_STAFF_GROUP_ID=
LINE_ADMIN_USER_IDS=

# 公平性管理シート（Google Apps Script の Web アプリ URL）
GOOGLE_SHEETS_WEBHOOK_URL=
